# ── CLAIR Gateway configuration ──────────────────────────────────────────────
# Copy to .env and adjust. Every value can also be set as a real env variable
# (real environment variables always win over .env).

# Gateway HTTP port
PORT=8080

# ── CLAIR Base (immutable service, reached over HTTP) ────────────────────────
CLAIR_BASE_URL=http://127.0.0.1:3000
# Timeout for a single /compress call, ms
CLAIR_TIMEOUT_MS=10000
# Optional pinning if your CLAIR Base uses non-default field names.
# Request field that carries the prompt (default: "text")
#CLAIR_TEXT_FIELD=text
# Dot-path to the compressed text inside the response (default: auto-detect,
# e.g. "compressed" | "compressed_text" | "data.compressed_text" | "result")
#CLAIR_RESPONSE_FIELD=compressed

# ── Upstream LLM (any OpenAI-compatible API) ─────────────────────────────────
# Root of the provider API, with or without the /v1 suffix:
#   https://api.openai.com            → paths are appended as-is (/v1/chat/completions)
#   http://localhost:11434/v1         → the /v1 prefix is not duplicated
LLM_PROVIDER_URL=https://api.openai.com
# If empty, the incoming Authorization header is forwarded as is
LLM_API_KEY=
# Timeout for the LLM request (until response headers), ms; 0 = disabled
LLM_TIMEOUT_MS=300000

# ── Compression ──────────────────────────────────────────────────────────────
# low | medium | high — passed to CLAIR Base in the request
COMPRESSION_MODE=medium
# Global kill-switch for A/B tests; per-request override: X-Clair-Compress header
COMPRESSION_ENABLED=true
# What to do when CLAIR Base is unreachable/timing out:
#   fail_open   → forward the original prompt to the LLM (default)
#   fail_closed → answer 503 in the OpenAI error format
CLAIR_FAIL_STRATEGY=fail_open

# ── Observability ────────────────────────────────────────────────────────────
# Session label written to the CLAIR request and to the JSONL log
SESSION_NAME=clair-gateway
# debug | info | warn | error
LOG_LEVEL=info
# JSONL operation log; "none" disables file logging
LOG_FILE=logs/gateway.jsonl

# Max accepted request body size, MB
BODY_LIMIT_MB=20
